# Nome do pacote e autor que aparecem na figurinha
STICKER_PACK=Minhas Figurinhas
STICKER_AUTHOR=bot

# Grupos autorizados (JIDs separados por vírgula). Mande "!id" no grupo para descobrir o JID.
ALLOWED_GROUPS=
# Ou pelo nome exato do grupo (separados por vírgula)
ALLOWED_GROUP_NAMES=Stickers
# Contatos autorizados no privado (ex.: 5511999999999@s.whatsapp.net)
ALLOWED_USERS=
# true = responde em qualquer conversa (cuidado)
ALLOW_ALL=false

# Duração máxima das figurinhas animadas (segundos)
MAX_VIDEO_SECONDS=8
# Caminho do yt-dlp (para links que não são do X)
YTDLP_PATH=yt-dlp
